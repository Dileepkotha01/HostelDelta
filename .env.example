# Required for browser authentication and server-side Supabase calls.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set these to the public origins for the relevant deployment. In production,
# NEXT_PUBLIC_APP_URL must use the canonical root/app domain for host validation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_SUBDOMAIN=
NEXT_PUBLIC_ADMIN_SUBDOMAIN=

# Required for private signed resident/payment links. Use a unique random value
# with at least 32 bytes of entropy; never reuse CRON_SECRET or a provider secret.
SIGNED_LINK_SECRET=

# Optional payment integration. Never expose the secret or webhook secret with
# a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_HOSTEL_SUBSCRIPTION_PLAN_ID=

# Optional mail transport.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required only when enabling the protected subscription-expiry cron endpoint.
# Use a unique random value with at least 32 bytes of entropy.
CRON_SECRET=

# Optional demo seed controls. Keep these unset except for a dedicated
# development/test Supabase project; never point seed scripts at production.
ALLOW_DEMO_SEED=
DEMO_SEED_TARGET_URL=
DEMO_EMAIL=
DEMO_PASSWORD=
